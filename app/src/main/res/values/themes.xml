<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ערכת נושא Material Design 3: רקע שנהב, כפתורים בשחור דיו, בלי ActionBar -->
    <style name="Theme.BasketballShotAnalyzer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/ivory</item>
        <item name="colorPrimaryContainer">@color/hairline</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/ivory</item>
        <item name="colorSurface">@color/ivory</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/ivory</item>
        <item name="android:statusBarColor">@color/ivory</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- כפתור ראשי: מלבן שחור, טקסט מרווח -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- כפתור משני: מסגרת שחורה דקה -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">2dp</item>
        <item name="strokeColor">@color/ink</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- כפתור טקסט קטן (התנתקות, עריכה, מחיקה) -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- שדה קלט עם קו תחתון בלבד, בלי מסגרת -->
    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeColor">@color/ink</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="hintTextColor">@color/ink</item>
        <item name="endIconTint">@color/ink_secondary</item>
    </style>

    <!-- קו מפריד דק -->
    <style name="App.Hairline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/hairline</item>
    </style>

    <!-- טיפוגרפיה: סריף לכותרות ולמספרים, סאנס-סריף לטקסט רגיל -->
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- שם האפליקציה באנגלית: אותיות גדולות ומרווחות -->
    <style name="TextAppearance.App.Wordmark" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
