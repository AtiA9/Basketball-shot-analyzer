<?xml version="1.0" encoding="utf-8"?>
<!-- רקע לתיבת המשוב: נייר קלף עם פס פליז בצד -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brass" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:start="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/feedback_bg" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
